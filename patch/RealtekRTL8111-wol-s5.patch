index 164d40e..6f662e0 100644
--- a/RealtekRTL8111/RealtekRTL8111.cpp
+++ b/RealtekRTL8111/RealtekRTL8111.cpp
@@ -92,6 +92,7 @@ bool RTL8111::init(OSDictionary *properties)
         lastIntrTime = 0;
         wolCapable = false;
         wolActive = false;
+        wolArmedOnDisable = false;
         enableTSO4 = false;
         enableTSO6 = false;
         enableCSO6 = false;
@@ -344,10 +345,62 @@ void RTL8111::systemWillShutdown(IOOptionBits specifier)
     DebugLog("systemWillShutdown() ===>\n");
     
     if ((kIOMessageSystemWillPowerOff | kIOMessageSystemWillRestart) & specifier) {
+        /*
+         * WoL from S5: macOS arms WoL only for sleep, so arm magic packet wakeup here,
+         * for a power off and for a restart. After a restart the next boot finds the
+         * magic packet bit (ERI 0xDE bit 0) set and WoL stays enabled.
+         */
+        bool armWoL = wolCapable && ((specifier == kIOMessageSystemWillPowerOff) ||
+                                     (specifier == kIOMessageSystemWillRestart));
+
+        if (armWoL) {
+            wolActive = true;
+            linuxData.wol_enabled = WOL_ENABLED;
+            linuxData.wol_opts |= WAKE_MAGIC;
+        }
         disable(netif);
         
+        /*
+         * The kernel takes all interfaces down (if_down_all()) before this is called, with
+         * the WoL setting of the moment. After a wake macOS has called
+         * setWakeOnMagicPacket(false), so rtl8168_powerdown_pll() powered the PHY and
+         * the PLL down, and disable() did nothing here. Power them up again and power
+         * down with WoL, as disable() does. Not when the interface went down with WoL:
+         * a second power-down would renegotiate before the link partner's abilities
+         * are known, and the link would come up at 100 Mbit/s instead of 10.
+         */
+        if (armWoL && !wolArmedOnDisable) {
+            rtl8168_powerup_pll(&linuxData);
+            
+            switch (linuxData.mcfg) {
+                case CFG_METHOD_14 ... CFG_METHOD_15:
+                    WriteReg8(0xD0, ReadReg8(0xD0) | BIT_6);
+                    break;
+                    
+                case CFG_METHOD_16 ... CFG_METHOD_32:
+                    WriteReg8(0xD0, ReadReg8(0xD0) | BIT_6);
+                    WriteReg8(0xF2, ReadReg8(0xF2) | BIT_6);
+                    break;
+                    
+                default:
+                    break;
+            }
+            rtl8168_powerdown_pll(&linuxData);
+        }
+        
         /* Restore the original MAC address. */
         rtl8168_rar_set(&linuxData, (UInt8 *)&origMacAddr.bytes);
+        
+        if (armWoL) {
+            /* Clear a stale PME_Status (write 1 to clear), the BIOS sets PME_En. */
+            if (pciDevice && pciPMCtrlOffset) {
+                UInt16 val16 = pciDevice->extendedConfigRead16(pciPMCtrlOffset);
+                
+                if (val16 & kPCIPMCSPMEStatus)
+                    pciDevice->extendedConfigWrite16(pciPMCtrlOffset, val16);
+            }
+            IOLog("Ethernet [RealtekRTL8111]: WoL from S5 armed.\n");
+        }
     }
     
     DebugLog("systemWillShutdown() <===\n");
